# Copy to the repository root as .env and fill your own project credentials.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Use the server-only legacy service_role JWT with the current REST adapter.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_PHOTOS_BUCKET=feedsure-photos
SUPABASE_TIMEOUT_SECONDS=5
AUTH_PROVIDER=supabase
PHOTO_STORAGE_PROVIDER=supabase
STAGE=supabase-test
UPLOAD_MAX_BYTES=3500000
UPLOAD_EXPIRY_SECONDS=300
