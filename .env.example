# ---------- Shared ----------
STAGE=dev
AWS_REGION=ap-south-1
# Optional per-service overrides if a service is not in AWS_REGION
BEDROCK_REGION=ap-south-1
LOCATION_REGION=ap-south-1
TZ_NAME=Asia/Kolkata

# ---------- Backend (Lambda env / local) ----------
GENERATORS_TABLE=feedsure-dev-Generators
HISTORY_TABLE=feedsure-dev-History
SUBMISSIONS_TABLE=feedsure-dev-Submissions
PLANS_TABLE=feedsure-dev-Plans
PHOTOS_BUCKET=feedsure-dev-photos-CHANGE_ME
UPLOAD_MIN_BYTES=1024
UPLOAD_MAX_BYTES=3500000
UPLOAD_EXPIRY_SECONDS=300
PHOTO_RETENTION_DAYS=30
PHOTO_MAX_DIMENSION=8192
PHOTO_MAX_PIXELS=16000000
PHOTO_MAX_DECODED_BYTES=40000000

# Image-capable model ID or inference profile ID enabled in your account (see docs/DEPLOYMENT.md)
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=600

# Optional v3 photo provider: bedrock or nvidia. MOCK_BEDROCK=true overrides either.
PHOTO_ANALYSIS_PROVIDER=bedrock
# Server-side only; never put this key in VITE_ variables or commit the real value.
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=nvidia/nemotron-nano-12b-v2-vl
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MAX_TOKENS=600
NVIDIA_TIMEOUT_SECONDS=5

# Long random string; never commit the real value
ADMIN_TOKEN=CHANGE_ME
PLANT_OWNER_TOKEN=CHANGE_ME
ALLOWED_ORIGIN=http://localhost:5173

# Screening rules
HOLD_THRESHOLD_PCT=5
INSPECT_MIN_PCT=1
MIN_CONFIDENCE=0.6
P_ACCEPT_ACCEPT=0.95
P_ACCEPT_INSPECT=0.6
DEFAULT_PRIOR_ACCEPT=0.7
DEFAULT_PRIOR_CONTAM_PCT=2

# Planner
# Approximate Harohalli town-centre coordinates; verify the plant map pin before deployment.
PLANT_LAT=12.681
PLANT_LNG=77.474
TARGET_KG=1200
TRUCK_CAPACITY_KG=2000
SHIFT_START=06:00
SHIFT_END=11:00
SERVICE_MIN=10
MAX_RADIUS_KM=15
ROAD_FACTOR=1.3
FALLBACK_SPEED_KMPH=20
STOP_AT_TARGET=false

# Local/offline mode
MOCK_BEDROCK=false
# With MOCK_BEDROCK=true: auto (= clean for v3), clean, plastic, hazard,
# low_confidence or malformed. Fixtures never analyse the selected photo.
MOCK_BEDROCK_FIXTURE=auto
MOCK_LOCATION=false
# auto follows MOCK_LOCATION; location uses AWS truck roads; osrm uses driving roads.
# Public OSRM is intended for the local demo, not a production routing SLA.
ROUTING_PROVIDER=auto
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=6
# Set to http://localhost:5000 when using docker-compose (moto). Leave empty for real AWS.
AWS_ENDPOINT_URL=

# ---------- Frontend (Vite, must start with VITE_) ----------
VITE_API_BASE_URL=http://localhost:8787
VITE_AWS_REGION=ap-south-1
VITE_LOCATION_API_KEY=CHANGE_ME
# Keyless OpenStreetMap tiles for loopback demos; use off to disable.
# A configured Amazon Location key takes precedence. Not road navigation.
VITE_LOCAL_DEMO_BASEMAP=osm

# V3 operational storage and assumptions
OPERATIONS_TABLE=feedsure-dev-Operations
PICKUPS_TABLE=feedsure-dev-Pickups
GATE_LOGS_TABLE=feedsure-dev-GateLogs
MUTATION_LOG_TABLE=feedsure-dev-MutationLog
CAPACITY_BUFFER=0.10
READINESS_PRIOR=0.8
READY_CUTOFF=20:00
# Separate random secret; blank disables dispatch, never commit a real secret.
DRIVER_TOKEN_SECRET=
DRIVER_TOKEN_HOURS=12
GPS_RETENTION_DAYS=30
GPS_ACCURACY_M=100
GEOFENCE_M=150
ABSOLUTE_TOLERANCE_KG=20
PERCENTAGE_TOLERANCE_PCT=5
DEDUP_RETENTION_DAYS=7

# Optional Supabase account login and private image storage. Defaults retain tokens/S3.
AUTH_PROVIDER=tokens
PHOTO_STORAGE_PROVIDER=s3
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only: never expose this value in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTOS_BUCKET=feedsure-photos
SUPABASE_TIMEOUT_SECONDS=5
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# After running all Supabase migrations (including accounts and admin_creation_role):
SUPABASE_ACCOUNT_MANAGEMENT=false
